<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="P4KX"
      Language="1033"
      Codepage="1252"
      Version="$(var.Version)"
      Manufacturer="KRT"
      UpgradeCode="090C8F25-8543-42F0-B40A-1514653149F9"
      Scope="perUser">
    <SummaryInformation Manufacturer="KRT" Description="P4KX $(var.Version)" />
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/greluc/P4KX" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="UserPrograms" Name="Programs">
        <Directory Id="APPLICATIONFOLDER" Name="P4KX">
          <Component Id="Application" Guid="63EEC150-779C-40C1-B6D0-5CDB0F649CBA">
            <File Id="GuiExe" Name="p4kx-gui.exe" Source="$(var.BinaryFolder)\p4kx-gui.exe" />
            <File Id="CliExe" Name="p4kx.exe" Source="$(var.BinaryFolder)\p4kx.exe" />
            <File Id="McpExe" Name="p4kx-mcp.exe" Source="$(var.BinaryFolder)\p4kx-mcp.exe" />
            <File Id="LicenceMit" Name="LICENSE-MIT" Source="$(var.RepositoryFolder)\LICENSE-MIT" />
            <File Id="LicenceApache" Name="LICENSE-APACHE" Source="$(var.RepositoryFolder)\LICENSE-APACHE" />
            <File Id="ThirdPartyNotices" Name="THIRD-PARTY-NOTICES" Source="$(var.RepositoryFolder)\THIRD-PARTY-NOTICES" />
            <RegistryValue
                Root="HKCU"
                Key="Software\KRT\P4KX"
                Name="Application"
                Type="integer"
                Value="1"
                KeyPath="yes" />
            <Environment
                Id="UserPath"
                Name="PATH"
                Value="[APPLICATIONFOLDER]"
                Action="set"
                Part="last"
                Permanent="no"
                System="no" />
            <RemoveFolder Id="RemoveApplicationFolder" Directory="APPLICATIONFOLDER" On="uninstall" />
            <RemoveFolder Id="RemoveUserPrograms" Directory="UserPrograms" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="A0168EBF-245F-4907-BB41-58C1B5F456B9">
        <Shortcut
            Id="GuiShortcut"
            Name="P4KX"
            Description="Open, browse and extract Star Citizen Archives"
            Target="[APPLICATIONFOLDER]p4kx-gui.exe"
            WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\KRT\P4KX"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Complete" Title="P4KX" Level="1">
      <ComponentRef Id="Application" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
