<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
      Id="*"
      Name="P4K-Extractor"
      Language="1033"
      Codepage="1252"
      Version="$(var.Version)"
      Manufacturer="KRT"
      UpgradeCode="090C8F25-8543-42F0-B40A-1514653149F9">
    <Package
        InstallerVersion="500"
        Compressed="yes"
        InstallScope="perUser"
        InstallPrivileges="limited"
        Manufacturer="KRT"
        Description="P4K-Extractor $(var.Version)" />
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/krt-profit/p4k-extractor" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="UserPrograms" Name="Programs">
          <Directory Id="APPLICATIONFOLDER" Name="P4K-Extractor" />
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="APPLICATIONFOLDER">
      <Component Id="Application" Guid="9C73F6D4-7407-4BDB-A3F1-105F2206BAE2">
        <File Id="GuiExe" Name="p4kx-gui.exe" Source="$(var.CargoTargetBinDir)\p4kx-gui.exe" />
        <File Id="CliExe" Name="p4kx.exe" Source="$(var.CargoTargetBinDir)\p4kx.exe" />
        <File Id="LicenceMit" Name="LICENSE-MIT" Source="$(var.CargoTargetDir)\..\LICENSE-MIT" />
        <File Id="LicenceApache" Name="LICENSE-APACHE" Source="$(var.CargoTargetDir)\..\LICENSE-APACHE" />
        <RegistryValue
            Root="HKCU"
            Key="Software\KRT\P4K-Extractor"
            Name="Application"
            Type="integer"
            Value="1"
            KeyPath="yes" />
        <Environment
            Id="UserPath"
            Name="PATH"
            Value="[APPLICATIONFOLDER]"
            Action="set"
            Part="last"
            Permanent="no"
            System="no" />
        <RemoveFolder Id="RemoveApplicationFolder" Directory="APPLICATIONFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveUserPrograms" Directory="UserPrograms" On="uninstall" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="8540214F-7191-4490-A64B-29CA4A0520F5">
        <Shortcut
            Id="GuiShortcut"
            Name="P4K-Extractor"
            Description="Open, browse and extract Star Citizen Archives"
            Target="[APPLICATIONFOLDER]p4kx-gui.exe"
            WorkingDirectory="APPLICATIONFOLDER" />
        <RegistryValue
            Root="HKCU"
            Key="Software\KRT\P4K-Extractor"
            Name="StartMenuShortcut"
            Type="integer"
            Value="1"
            KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Complete" Title="P4K-Extractor" Level="1">
      <ComponentRef Id="Application" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
