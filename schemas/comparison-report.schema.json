{
  "$defs": {
    "ChangeKind": {
      "description": "How an Entry differs between the two sides of a Comparison.",
      "oneOf": [
        {
          "const": "added",
          "description": "Only the new side has the Entry.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "Only the old side has the Entry.",
          "type": "string"
        },
        {
          "const": "changed",
          "description": "Both sides have the Entry, with a different uncompressed size or CRC-32C.",
          "type": "string"
        }
      ]
    },
    "DirectoryCounts": {
      "description": "The counts of the changed Entries below one top-level directory.",
      "properties": {
        "added": {
          "description": "Entries only the new side has.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "changed": {
          "description": "Entries with a different uncompressed size or CRC-32C.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "directory": {
          "description": "The top-level directory as the first changed Entry below it spells it; empty for Entries\nat the root.",
          "type": "string"
        },
        "removed": {
          "description": "Entries only the old side has.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "directory",
        "added",
        "removed",
        "changed"
      ],
      "type": "object"
    },
    "EntryChangeReport": {
      "description": "One added, removed or changed Entry.",
      "properties": {
        "change": {
          "$ref": "#/$defs/ChangeKind",
          "description": "How the Entry differs."
        },
        "new": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntryState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Entry on the new side, absent when it was removed."
        },
        "old": {
          "anyOf": [
            {
              "$ref": "#/$defs/EntryState"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Entry on the old side, absent when it was added."
        },
        "path": {
          "description": "The Entry path as the new side stores it, or the old side for a removed Entry.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "change"
      ],
      "type": "object"
    },
    "EntryCounts": {
      "description": "The number of Entries per change kind.",
      "properties": {
        "added": {
          "description": "Entries only the new side has.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "changed": {
          "description": "Entries with a different uncompressed size or CRC-32C.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "description": "Entries only the old side has.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "added",
        "removed",
        "changed"
      ],
      "type": "object"
    },
    "EntryLevel": {
      "description": "The Entries added, removed and changed.",
      "properties": {
        "changes": {
          "description": "Every added, removed or changed Entry, ordered by path ignoring case and separator kind.",
          "items": {
            "$ref": "#/$defs/EntryChangeReport"
          },
          "type": "array"
        },
        "counts": {
          "$ref": "#/$defs/EntryCounts",
          "description": "The number of Entries per change kind."
        },
        "directories": {
          "description": "The counts per top-level directory, ordered by directory ignoring case.",
          "items": {
            "$ref": "#/$defs/DirectoryCounts"
          },
          "type": "array"
        }
      },
      "required": [
        "counts",
        "directories",
        "changes"
      ],
      "type": "object"
    },
    "EntryState": {
      "anyOf": [
        {
          "oneOf": [
            {
              "description": "The CRC-32C (Castagnoli), which Archives store.",
              "properties": {
                "crc32c": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "crc32c"
              ],
              "type": "object"
            },
            {
              "description": "The plain ZIP CRC-32, which plain ZIP archives store.",
              "properties": {
                "crc32": {
                  "format": "uint32",
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "crc32"
              ],
              "type": "object"
            },
            {
              "description": "The SHA-256 as 64 lower-case hex digits; an Entry's checksum is never one, the arm keeps\nthe report total.",
              "properties": {
                "sha256": {
                  "type": "string"
                }
              },
              "required": [
                "sha256"
              ],
              "type": "object"
            }
          ]
        },
        {}
      ],
      "description": "What the central directory says about one side of an Entry.",
      "properties": {
        "size": {
          "description": "The uncompressed size in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size"
      ],
      "type": "object"
    },
    "FieldChangeReport": {
      "description": "One field or array element whose value differs, or that only one side has.",
      "properties": {
        "new": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The new value, absent when the new side has no such field or element."
        },
        "old": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The old value, absent when the old side has no such field or element."
        },
        "path": {
          "description": "Where the value lies in the Record: the field names separated by `.`, with `[index]`\nafter an array field, e.g. `hull.plates[1].armor`.",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "type": "object"
    },
    "Float": {
      "description": "A float: a number, or NaN, INF or -INF.",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "enum": [
            "NaN",
            "INF",
            "-INF"
          ],
          "type": "string"
        }
      ]
    },
    "Guid": {
      "description": "A GUID of the form xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "Level": {
      "description": "One level a Comparison works on.",
      "oneOf": [
        {
          "const": "entries",
          "description": "Entries added, removed or changed, from the central directories.",
          "type": "string"
        },
        {
          "const": "records",
          "description": "Records added, removed, moved or changed, joined by GUID.",
          "type": "string"
        }
      ]
    },
    "RecordChangeKind": {
      "description": "How a Record differs between the two sides of a Comparison.",
      "oneOf": [
        {
          "const": "added",
          "description": "Only the new side has the GUID.",
          "type": "string"
        },
        {
          "const": "removed",
          "description": "Only the old side has the GUID.",
          "type": "string"
        },
        {
          "const": "moved",
          "description": "Both sides have the GUID at different record paths; fields may differ as well.",
          "type": "string"
        },
        {
          "const": "changed",
          "description": "Both sides have the GUID at the same record path, with a different name, tag, type or field.",
          "type": "string"
        },
        {
          "const": "unreadable",
          "description": "The Record cannot be read on at least one side, so it was not compared.",
          "type": "string"
        }
      ]
    },
    "RecordChangeReport": {
      "description": "One added, removed, moved, changed or unreadable Record.",
      "properties": {
        "change": {
          "$ref": "#/$defs/RecordChangeKind",
          "description": "How the Record differs."
        },
        "errors": {
          "description": "Why the Record cannot be read, one entry per side; absent unless it is unreadable.",
          "items": {
            "$ref": "#/$defs/RecordErrorReport"
          },
          "type": "array"
        },
        "fields": {
          "description": "The changed fields and array elements, nested ones included, depth first in field order\nof the new side with the fields only the old side has last in each struct; empty for an\nadded, removed or unreadable Record.",
          "items": {
            "$ref": "#/$defs/FieldChangeReport"
          },
          "type": "array"
        },
        "guid": {
          "$ref": "#/$defs/Guid",
          "description": "The GUID that joins both sides."
        },
        "new": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordStateReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Record on the new side, absent when it was removed or cannot be read."
        },
        "old": {
          "anyOf": [
            {
              "$ref": "#/$defs/RecordStateReport"
            },
            {
              "type": "null"
            }
          ],
          "description": "The Record on the old side, absent when it was added or cannot be read."
        }
      },
      "required": [
        "guid",
        "change",
        "fields"
      ],
      "type": "object"
    },
    "RecordCounts": {
      "description": "The number of Records per change kind.",
      "properties": {
        "added": {
          "description": "Records only the new side has.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "changed": {
          "description": "Records at the same record path with a different name, type or field.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "moved": {
          "description": "Records at another record path.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "removed": {
          "description": "Records only the old side has.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "unreadable": {
          "description": "Records that cannot be read on at least one side.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "added",
        "removed",
        "moved",
        "changed",
        "unreadable"
      ],
      "type": "object"
    },
    "RecordErrorReport": {
      "description": "Why a Record cannot be read on one side.",
      "properties": {
        "reason": {
          "description": "What cannot be read.",
          "type": "string"
        },
        "side": {
          "$ref": "#/$defs/RecordSide",
          "description": "The side whose Record cannot be read."
        }
      },
      "required": [
        "side",
        "reason"
      ],
      "type": "object"
    },
    "RecordLevel": {
      "description": "The Records added, removed, moved, changed and unreadable.",
      "properties": {
        "changes": {
          "description": "Every added, removed, moved, changed or unreadable Record, ordered by record path ignoring\ncase and separator kind, then by GUID.",
          "items": {
            "$ref": "#/$defs/RecordChangeReport"
          },
          "type": "array"
        },
        "counts": {
          "$ref": "#/$defs/RecordCounts",
          "description": "The number of Records per change kind."
        }
      },
      "required": [
        "counts",
        "changes"
      ],
      "type": "object"
    },
    "RecordSide": {
      "description": "One side of a Comparison.",
      "oneOf": [
        {
          "const": "old",
          "description": "The old Archive.",
          "type": "string"
        },
        {
          "const": "new",
          "description": "The new Archive.",
          "type": "string"
        }
      ]
    },
    "RecordStateReport": {
      "description": "What identifies a Record on one side.",
      "properties": {
        "name": {
          "description": "The Record name, e.g. `EntityClassDefinition.AEGS_Avenger`.",
          "type": "string"
        },
        "record_path": {
          "description": "The record path, without `.xml`.",
          "type": "string"
        },
        "tag": {
          "description": "The Record tag, e.g. `SystemsDesign`; absent in a version 6 DataForge and for a Record\nwithout tag.",
          "type": "string"
        },
        "type": {
          "description": "The name of the Record's struct.",
          "type": "string"
        }
      },
      "required": [
        "record_path",
        "name",
        "tag",
        "type"
      ],
      "type": "object"
    },
    "ReferenceReport": {
      "description": "The target of a Reference.",
      "properties": {
        "at": {
          "description": "For a weak pointer, where inside the target Record it points, e.g. `wheels[0]`; absent\nfor the Record itself.",
          "type": [
            "string",
            "null"
          ]
        },
        "guid": {
          "$ref": "#/$defs/Guid",
          "description": "The GUID of the target Record."
        },
        "record_path": {
          "description": "The record path of the target Record, without `.xml`.",
          "type": "string"
        },
        "type": {
          "description": "The type of the target: the struct of the Record, or of the instance at `at`.",
          "type": "string"
        }
      },
      "required": [
        "guid",
        "record_path",
        "type"
      ],
      "type": "object"
    },
    "SourceSide": {
      "description": "One Archive of a Comparison.",
      "properties": {
        "archive": {
          "description": "The path the Archive was opened from.",
          "type": "string"
        },
        "build": {
          "description": "The Build from the Channel's build manifest, `null` when it is unknown.",
          "properties": {
            "branch": {
              "description": "The branch, e.g. `sc-alpha-4.10.2`.",
              "type": "string"
            },
            "build_id": {
              "description": "The `BuildId` GUID.",
              "type": "string"
            },
            "change_number": {
              "description": "The Perforce change number the Build was made from.",
              "type": "string"
            },
            "public_patch": {
              "description": "The public patch version, e.g. `4.7.2`, from the RSI Launcher log; `null` when the log has\nno line for the change number.",
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "description": "The version, e.g. `4.10.197.2878`.",
              "type": "string"
            }
          },
          "required": [
            "branch",
            "version",
            "change_number",
            "build_id"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "channel": {
          "description": "The Channel: the name of the folder holding the Archive, `null` when there is none.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "archive",
        "channel",
        "build"
      ],
      "type": "object"
    },
    "Sources": {
      "description": "The two Archives of a Comparison.",
      "properties": {
        "new": {
          "$ref": "#/$defs/SourceSide",
          "description": "The Archive the changes lead to."
        },
        "old": {
          "$ref": "#/$defs/SourceSide",
          "description": "The Archive the changes start from."
        }
      },
      "required": [
        "old",
        "new"
      ],
      "type": "object"
    },
    "ValueReport": {
      "description": "One side's value of a changed field or array element, with its type.",
      "oneOf": [
        {
          "description": "A boolean.",
          "properties": {
            "type": {
              "const": "bool",
              "type": "string"
            },
            "value": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A signed 8-bit integer.",
          "properties": {
            "type": {
              "const": "int8",
              "type": "string"
            },
            "value": {
              "format": "int8",
              "maximum": 127,
              "minimum": -128,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A signed 16-bit integer.",
          "properties": {
            "type": {
              "const": "int16",
              "type": "string"
            },
            "value": {
              "format": "int16",
              "maximum": 32767,
              "minimum": -32768,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A signed 32-bit integer.",
          "properties": {
            "type": {
              "const": "int32",
              "type": "string"
            },
            "value": {
              "format": "int32",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A signed 64-bit integer.",
          "properties": {
            "type": {
              "const": "int64",
              "type": "string"
            },
            "value": {
              "format": "int64",
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "An unsigned 8-bit integer.",
          "properties": {
            "type": {
              "const": "uint8",
              "type": "string"
            },
            "value": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "An unsigned 16-bit integer.",
          "properties": {
            "type": {
              "const": "uint16",
              "type": "string"
            },
            "value": {
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "An unsigned 32-bit integer.",
          "properties": {
            "type": {
              "const": "uint32",
              "type": "string"
            },
            "value": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "An unsigned 64-bit integer.",
          "properties": {
            "type": {
              "const": "uint64",
              "type": "string"
            },
            "value": {
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A 32-bit float; `NaN`, `INF` and `-INF` as strings.",
          "properties": {
            "type": {
              "const": "single",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Float"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A 64-bit float; `NaN`, `INF` and `-INF` as strings.",
          "properties": {
            "type": {
              "const": "double",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Float"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A string.",
          "properties": {
            "type": {
              "const": "string",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A localisation key, e.g. `@item_Name`.",
          "properties": {
            "type": {
              "const": "locale",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A GUID.",
          "properties": {
            "type": {
              "const": "guid",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/Guid"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "The name of an enum option.",
          "properties": {
            "type": {
              "const": "enum",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A link to a Record, or for a weak pointer to a place inside the Record.",
          "properties": {
            "type": {
              "const": "reference",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/ReferenceReport"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A struct, as the name of its type; its fields follow as changes of their own.",
          "properties": {
            "type": {
              "const": "struct",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "An array, as its number of elements; its elements follow as changes of their own.",
          "properties": {
            "type": {
              "const": "array",
              "type": "string"
            },
            "value": {
              "format": "uint",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        },
        {
          "description": "A null pointer or a null Reference.",
          "properties": {
            "type": {
              "const": "null",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A value that cannot be read, as the reason.",
          "properties": {
            "type": {
              "const": "error",
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The JSON report of a Comparison between an old and a new Archive.",
  "properties": {
    "entries": {
      "anyOf": [
        {
          "$ref": "#/$defs/EntryLevel"
        },
        {
          "type": "null"
        }
      ],
      "description": "The Entry level, present when it was compared."
    },
    "filter": {
      "description": "The Filter that selected the Entries by path and the Records by either record path on\nboth sides, `null` when everything was compared.",
      "type": [
        "string",
        "null"
      ]
    },
    "format_version": {
      "description": "The version of the report shape.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "levels": {
      "description": "The levels compared.",
      "items": {
        "$ref": "#/$defs/Level"
      },
      "type": "array"
    },
    "records": {
